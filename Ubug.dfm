  object Mbug: TMemo
    Left = 11
    Top = 77
    Width = 325
    Height = 128
    TabStop = False
    BevelInner = bvNone
    BevelOuter = bvNone
    Ctl3D = False
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -11
    Font.Name = 'Verdana'
    Font.Style = []
    Lines.Strings = (
      'Dies ist das Bugreportforumlar. Hier k'#246'nnen Sie '
      'einen gefunden Programmfehler an uns '#252'bermitteln, '
      'damit wir ihn so schnell wie m'#246'glich beheben '
      'k'#246'nnen. '
      'Nat'#252'rlich k'#246'nnen Sie auch einen '
      'Ver'#228'nderungsvorschlag o. '#228'. an uns senden, damit '
      'wir es in das Programm einbauen k'#246'nnen.')
    ParentColor = True
    ParentCtl3D = False
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssVertical
    TabOrder = 0
    WantReturns = False
  end
  object Minfo: TMemo
    Left = 358
    Top = 77
    Width = 325
    Height = 128
    TabStop = False
    BevelInner = bvNone
    BevelOuter = bvNone
    Ctl3D = False
    Font.Charset = DEFAULT_CHARSET
    Font.Color = clWindowText
    Font.Height = -11
    Font.Name = 'Verdana'
    Font.Style = []
    Lines.Strings = (
      'Es werden lediglich die Daten '#252'bermittelt, die Sie in '
      'die Felder unterhalb eingetragen haben, weder '
      'pers'#246'nliche, noch unpers'#246'nliche, noch andere Daten '
      'werden per ICQ-Protokoll an das Entwicklerteam '
      #252'bermittelt.'
      'Falls Sie dieser '#220'bermittlungsmethode misstrauen, '
      'wof'#252'r wir vollstest Verst'#228'ndis haben, k'#246'nnen Sie '
      'auch ihren Verbesserungsvorschlag manuell in '
      'unser Forum eintragen. Der Link dazu steht '
      'unterhalb.')
    ParentColor = True
    ParentCtl3D = False
    ParentFont = False
    ReadOnly = True
    ScrollBars = ssVertical
    TabOrder = 1
  end
