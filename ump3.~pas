   end else begin
    LoescheArrayElement ( zuloeschendes );
    if fsettings.cbplaylistsave.Checked then
    ArraySpeichern (aktuellePlayListe );
   end;

   ArrayZuListe;
   Gliste.markiertesElement:=ArrayIndexZuListenIndex(zuloeschendes);
   Gliste.fortschrittlichesElement:=merkeFortschritt;
