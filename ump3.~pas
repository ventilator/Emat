procedure TFmp3.DauerAuslesen(index:integer);
var dauer:integer;

begin
  if not FilterGraph.Active then FilterGraph.Active := true;
  FilterGraph.ClearGraph;

  try
   FilterGraph.RenderFile( mp3s[index].path+mp3s[index].filename);
   dauer:=FilterGraph.Duration div 1000;
   mp3s[index].dauer:= inttostr(dauer div 60)+':'+(format('%.2d',[dauer mod 60]));
  except
   mp3s[index].dauer:='defekt';
  end;
  FilterGraph.ClearGraph;
end;

