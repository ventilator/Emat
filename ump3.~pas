 schrittweite:=ieq.width div 11;
 for i:=0 to 9 do
 begin
  ieq.Canvas.Rectangle(i*schrittweite+schrittweite div 2, ieq.height-round (((eqwert[i+1]+15))/30*ieq.height), (i+1)*schrittweite-3+schrittweite div 2, ieq.height);
 end;

