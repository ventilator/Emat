procedure Tgliste2.Delay(wartezeit: integer);
var
  anfangsseit: integer;
begin
  anfangsseit := GetTickCount;
  while abs(GetTickCount) - anfangsseit <= wartezeit do
    begin
      Application.ProcessMessages;
      Sleep(1);
    end;
end;

