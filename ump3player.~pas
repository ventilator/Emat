unit ump3player;

interface

uses
  Windows, Messages, SysUtils, Variants, Classes, Graphics, Controls, Forms,
  Dialogs, XProgress, StdCtrls, CheckLst, ComCtrls, ShellCtrls, ExtCtrls,
  dxCore, dxContainer, ump3;

type
  TFMp3Player = class(TForm)
    STV: TShellTreeView;
    GroupBox1: TGroupBox;
    Epfad: TEdit;
    GroupBox2: TGroupBox;
    lb_files: TCheckListBox;
    BNummer: TButton;
    Label1: TLabel;
    Label2: TLabel;
    LAnzahl: TLabel;
    LSize: TLabel;
    Button1: TButton;
    Button2: TButton;
    Progress: TXProgress;
    Label3: TLabel;
    LDauer: TLabel;
    Button3: TButton;
    dxContainer1: TdxContainer;
    Splitter1: TSplitter;
    procedure Button3Click(Sender: TObject);
    procedure Button1Click(Sender: TObject);
    procedure Button2Click(Sender: TObject);
    procedure lb_filesClickCheck(Sender: TObject);
    procedure STVChange(Sender: TObject; Node: TTreeNode);
  private
    procedure KopiereMedien;
    procedure BerechneGesamtgroessen;

    { Private-Deklarationen }
  public
     procedure ErstelleMp3PlayerListe;
    { Public-Deklarationen }
  end;

var
  FMp3Player: TFMp3Player;
  MedienListe: TDatenbank;

implementation
{$R *.dfm}


procedure Tfmp3player.ErstelleMp3PlayerListe;
var i          :integer;
begin
  SetLength(Medienliste,High(Mp3Daten[1])+1);
  Medienliste:=Mp3Daten[1];
  lb_files.Clear;

  for i:=0 to high(Medienliste) do
  begin
    lb_files.Items.Add(fmp3.extractrealfilename(Medienliste[i].Filename));
    lb_files.Checked[i]:=true;
  end;
  BerechneGesamtgroessen;;

end;

procedure tfmp3player.BerechneGesamtgroessen;
var i,gesamtgroesse,anzahl:integer;
begin
  anzahl:=0;
  gesamtgroesse:=0;
  for i:=0 to high(Medienliste) do
  begin
    if lb_files.Checked[i] then
    begin
      inc(gesamtgroesse,Medienliste[i].size);
      inc(anzahl);
    end;
  end;

  LSize.Caption:=floattostrf(gesamtgroesse/(1024*1024),fffixed,10,2);
  LAnzahl.Caption:=inttostr(anzahl);
end;

procedure Tfmp3player. KopiereMedien;
var i           : integer;
    datei,ziel  : string;
begin
  ziel:=Epfad.text;
  ziel:=IncludeTrailingPathDelimiter(ziel);
  progress.Max:=high(medienliste);
  progress.Position:=0;

  if not directoryexists(ziel) then
  begin
  showmessage('Das Verzeichnis "'+ziel+'" existiert nicht.');
  exit;
  end;

  for i:=0 to high(medienliste) do
  begin

    if lb_files.Checked[i] then
    begin
      datei:=Medienliste[i].path+Medienliste[i].Filename;
      if fileexists(datei) then
      begin
        if not copyfile(pchar(datei),pchar(ziel+Medienliste[i].Filename),true)
        then showmessage('Die Datei "'+datei+'" konnte nicht kopiert werden.');
        progress.Position:=i;
        application.processmessages;
      end
      else
      begin
        showmessage('Die Datei "'+datei+'" existiert nicht.');
      end;
    end;
  end;
  progress.position:=0;
end;

procedure TFMp3Player.Button3Click(Sender: TObject);
begin
  ErstelleMp3PlayerListe;
end;

procedure TFMp3Player.Button1Click(Sender: TObject);
begin
close;
end;

procedure TFMp3Player.Button2Click(Sender: TObject);
begin
  KopiereMedien;
end;

procedure TFMp3Player.lb_filesClickCheck(Sender: TObject);
begin
  BerechneGesamtGroessen;
end;

procedure TFMp3Player.STVChange(Sender: TObject;
  Node: TTreeNode);
begin
 epfad.Text:=stv.Path;
end;

end.
