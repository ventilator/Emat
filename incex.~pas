unit incex;

interface
  procedure IncEx(var X: ordinal; max: ordinal; min: ordinal = 0); forward;

implementation

procedure IncEx(var X: ordinal; max: ordinal; min: ordinal = 0);
begin
  if X = max
    then X := min
    else inc(X);
end;

end.
 